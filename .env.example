SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Keep disabled until the product, company information and policies are complete.
STORE_LIVE=false
PRODUCT_CONFIRMED=false
LEGAL_CONFIRMED=false
PRODUCT_MATERIAL=Damasc Fine
BUSINESS_NAME=Pucioasa Premium
# Displayed in company details when configured; not a checkout activation condition.
BUSINESS_CUI=
BUSINESS_ADDRESS="Strada 8 Martie, fără număr, Pucioasa, județul Dâmbovița, România"
RETURN_ADDRESS="Strada 8 Martie, fără număr, Pucioasa, județul Dâmbovița, România"
CONTACT_EMAIL=contact@pucioasa-premium.ro
DELIVERY_ESTIMATE=48 de ore
# A randomly generated password of at least 32 characters, configured only in environment settings.
ADMIN_USER=admin
ADMIN_PASSWORD=
GOOGLE_SITE_VERIFICATION=
# Optional absolute ISO date with timezone. Never use a per-visitor resetting timer.
OFFER_ENDS_AT=
# Merchant-confirmed reference price in RON. Defaults to 199 in the catalog.
REFERENCE_PRICE_RON=199

# Enable only when ready to enforce the 86-minute online order window.
VISITOR_OFFER_ENABLED=false
# Generate a random secret of at least 32 characters in secure Vercel settings.
OFFER_SIGNING_SECRET=

# Order confirmations via Resend. Keep false until domain, mailbox and webhook are ready.
ORDER_EMAILS_ENABLED=false
RESEND_API_KEY=
STRIPE_WEBHOOK_SECRET=
ORDER_EMAIL_FROM="Pucioasa Premium <comenzi@pucioasa-premium.ro>"
# A working inbox for merchant alerts (can be an existing Gmail address).
ORDER_NOTIFICATION_EMAIL=pucioasapremium@gmail.com
# A monitored inbox for customer replies; may be the same address as above.
ORDER_REPLY_TO=pucioasapremium@gmail.com
